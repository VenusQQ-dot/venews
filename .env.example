# Supabase 後台資料庫
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 後台登入密碼
ADMIN_PASSWORD=your-secure-password

# 自動編輯部(Claude AI 新聞生成)
# API 金鑰 https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# 排程觸發的驗証密鑰(同時保護 /api/ingest 新聞 與 /api/stock-brief 台股情報)
# 產生方式:openssl rand -base64 24
CRON_SECRET=your-random-secret

# 台股盤後籌碼情報 Agent 不需額外變數:沿用上面的 SUPABASE_*、ANTHROPIC_API_KEY、CRON_SECRET。
# 啟用前先到 Supabase SQL Editor 執行 supabase/stock_schema.sql。詳見 README「台股盤後籌碼情報 Agent」。

# 外部 Claude Routines 發佈文章的驗証密鑰
# 產生方式:openssl rand -base64 24
PUBLISH_TOKEN=your-random-publish-token
